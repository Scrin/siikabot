{
  // Isolated sandbox for running Claude Code against this repository.
  "name": "claude-isolated",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "features": {
    // Go backend toolchain. Pinned to the same minor as go.mod's `go 1.25.0` and
    // the `golang:1.25` builder stage in the repo-root Dockerfile, so a local
    // `go build` fails and succeeds for the same reasons CI does.
    //
    // The base image is javascript-node, which ships no Go at all — without this
    // `go` is not on PATH and neither `go build ./...` nor `go test ./...` can
    // run. Frontend tooling (node/npm) comes from the base image.
    // Only `version` and `golangciLintVersion` are valid options (feature v1.3.4);
    // the feature sets GOROOT=/usr/local/go, GOPATH=/go and extends PATH itself.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.25"
    }
  },
  "containerEnv": {
    // Carried over from the template this config came from, where /workspace/.git
    // was a submodule pointer. In this repo /workspace/.git is an ordinary
    // directory, so this is a no-op and can be dropped.
    "GIT_WORK_TREE": "/workspace",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    // Set explicitly so the module-cache volume below has a stable target: the
    // Go feature decides GOPATH, and the default cache path derives from it.
    "GOMODCACHE": "/home/node/go/pkg/mod"
  },
  "mounts": [
    // Persist Claude Code auth/history/config across rebuilds (per-user, never committed).
    "source=claude-config,target=/home/node/.claude,type=volume",
    // Persist the Go module cache so a rebuild does not re-download every dependency.
    "source=siikabot-gomodcache,target=/home/node/go/pkg/mod,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code", "golang.go"]
    }
  },
  // Installs the latest Claude Code CLI each time the container is created,
  // with verify + retry to survive truncated native-binary downloads — a plain
  // `npm install -g` can exit 0 while leaving claude broken. See install-claude.sh.
  //
  // `go mod download` then pre-warms the module cache, which doubles as a
  // create-time check that the toolchain and its cgo dependencies actually work.
  "postCreateCommand": "bash .devcontainer/install-claude.sh && go mod download"
}
